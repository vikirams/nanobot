# ── Database (Postgres + pgvector) ──────────────────────────────────────────
# Leave empty to use SQLite fallback (legacy single-workspace mode)
NANOBOT_DATABASE__URL=postgresql://nanobot:nanobot@localhost:5432/nanobot
NANOBOT_DATABASE__POOL_MIN_SIZE=2
NANOBOT_DATABASE__POOL_MAX_SIZE=10

# ── Multi-tenancy ────────────────────────────────────────────────────────────
# Fallback account_id when inbound message carries no account_id
NANOBOT_AGENTS__DEFAULTS__DEFAULT_ACCOUNT_ID=default

# ── LLM provider ─────────────────────────────────────────────────────────────
# Example: OpenAI
# NANOBOT_PROVIDERS__OPENAI__API_KEY=sk-...
# NANOBOT_PROVIDERS__OPENAI__DEFAULT_MODEL=gpt-4o

# Example: Anthropic
# NANOBOT_PROVIDERS__ANTHROPIC__API_KEY=sk-ant-...
# NANOBOT_PROVIDERS__ANTHROPIC__DEFAULT_MODEL=claude-sonnet-4-6

# Embedding model (required for semantic memory / pgvector search)
# NANOBOT_PROVIDERS__OPENAI__EMBEDDING_MODEL=text-embedding-3-small

# ── Intent analysis (optional fast model via Groq) ───────────────────────────
# NANOBOT_PROVIDERS__GROQ__API_KEY=gsk_...
# NANOBOT_AGENTS__DEFAULTS__INTENT_MODEL=groq/llama-3.1-8b-instant
